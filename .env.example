# --- Required -------------------------------------------------------------------------
# Jellyfin that people sign in with (the server, not a browser URL that needs a proxy)
JELLYFIN_URL=http://10.0.0.10:8096
# RetroArr base URL, and a token from RetroArr Settings -> API access -> Tokens for other
# apps, with the "requests" scope only. The instance API key is refused on purpose.
RETROARR_URL=https://orion.example.ts.net:460
RETROARR_TOKEN=rat_...

# --- Optional -------------------------------------------------------------------------
# Where people play; "Ready to play" requests link here
#ROMM_URL=https://jellygame.example.com
# Discord channel webhook for new requests and status changes
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# g-seekr's own public origin; when set, changes from any other Origin are refused
#PUBLIC_URL=https://games.example.com

#HOST=0.0.0.0
#PORT=5056
#DATA_DIR=/data
# false only when served over plain http (local testing)
#SECURE_COOKIES=true
# Fastify trustProxy: loopback (default), true, a hop count, or addresses/CIDRs, comma-separated
#TRUST_PROXY=loopback
#JELLYFIN_ADMINS_ARE_ADMINS=true
# Requests per user per window (0 = unlimited; admins are never limited)
#REQUEST_LIMIT=10
#REQUEST_LIMIT_DAYS=7
# RetroArr platform slugs that may be requested; unset = every platform RetroArr has enabled
#ALLOWED_PLATFORMS=snes,gba,n64,psx,ps2,ngc,wii,3ds,switch
#POLL_SECONDS=300
#SESSION_DAYS=30
